<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.text.Font?>

<AnchorPane fx:id="rootPane" prefHeight="351.0" prefWidth="442.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.wudima.docApp.controllers.SearchPageController">
   <children>
      <StackPane layoutX="98.0" layoutY="31.0" prefHeight="152.0" prefWidth="246.0">
         <children>
            <ImageView fx:id="mainLogoView" fitHeight="146.0" fitWidth="246.0" pickOnBounds="true" preserveRatio="true" />
         </children>
      </StackPane>
      <Label fx:id="loadText" layoutX="156.0" layoutY="202.0" text="Enter Document  Number">
         <font>
            <Font name="System Bold" size="13.0" />
         </font></Label>
      <TextField fx:id="idField" layoutX="145.0" layoutY="240.0" promptText="ID Number" />
      <Button fx:id="findBtn" layoutX="201.0" layoutY="291.0" mnemonicParsing="false" onAction="#switchToDLoad" text="Find" />
      <Button fx:id="homeBtn" layoutX="14.0" layoutY="18.0" mnemonicParsing="false" onAction="#switchHome" />
   </children>
</AnchorPane>
